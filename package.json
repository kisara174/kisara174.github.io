{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node tools/check-site.mjs --public public",
    "verify": "npm test && npm run clean && npm run build && npm run check:site",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server --ip 127.0.0.1"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  },
  "devDependencies": {
    "hexo-front-matter": "4.2.1",
    "htmlparser2": "9.1.0"
  }
}
